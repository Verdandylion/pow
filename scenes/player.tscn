[gd_scene load_steps=3 format=3 uid="uid://powplay00002"]

; scenes/player.tscn
; First-person player.
;
; Scene tree:
;   Player  (CharacterBody3D)        ← physics body + movement script
;     CollisionShape3D               ← capsule collider (radius 0.3, height 1.8)
;     Head  (Node3D)                 ← rotates up/down on pitch
;       Camera  (Camera3D)           ← what the player sees
;       InteractionRay  (RayCast3D)  ← detects interactable objects (E key)

[ext_resource type="Script" path="res://scripts/player.gd" id="1_playerscript"]

[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_1"]
; radius × 2 + cylinder section = total height (0.3×2 + 1.2 = 1.8 m)
radius = 0.3
height = 1.8

[node name="Player" type="CharacterBody3D"]
script = ExtResource("1_playerscript")

; Shift the capsule up so its base sits at y = 0 (feet on the ground)
[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
shape = SubResource("CapsuleShape3D_1")

; Eye-level head pivot at 1.6 m (realistic adult eye height)
[node name="Head" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.6, 0)

[node name="Camera" type="Camera3D" parent="Head"]

; Ray points straight ahead (−Z) up to 3 m
[node name="InteractionRay" type="RayCast3D" parent="Head"]
target_position = Vector3(0, 0, -3)
enabled = true
